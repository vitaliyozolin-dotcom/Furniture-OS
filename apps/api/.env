APP_ENV=dev
APP_DEBUG=1
APP_SECRET=local-only-change-before-deployment
DATABASE_URL=postgresql://furniture:furniture@127.0.0.1:5432/furniture?charset=utf8
STORAGE_ROOT=/var/lib/furniture/files

# Local AI experiment. Put the real key in ignored apps/api/.env.local.
AI_ENABLED=0
AI_PROVIDER=nano_banana
POLZA_API_KEY=
AI_NANO_BANANA_MODEL=google/gemini-nano-banana-2.1
AI_HTTP_TIMEOUT_SECONDS=30
AI_POLZA_IMAGE_HOSTS=s3.polza.ai
AI_RENDER_ROOT=%kernel.project_dir%/var/ai-renders
# RUB kopecks: reserve up to 10 RUB per request, 1500 RUB for the experiment.
AI_MAX_COST_KOPECKS=1000
AI_BUDGET_KOPECKS=150000
