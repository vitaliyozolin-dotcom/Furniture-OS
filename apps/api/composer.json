{
  "name": "furniture-os/api",
  "type": "project",
  "require": {
    "php": "~8.4.0",
    "ext-pdo_pgsql": "*",
    "ext-intl": "*",
    "ext-bcmath": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/workflow": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.5",
    "league/flysystem": "^3.30",
    "league/flysystem-local": "^3.30",
    "symfony/clock": "7.4.*",
    "symfony/error-handler": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/password-hasher": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/security-core": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/stopwatch": "7.4.*",
    "symfony/string": "7.4.*",
    "symfony/type-info": "7.4.*",
    "symfony/var-dumper": "7.4.*",
    "symfony/var-exporter": "7.4.*",
    "symfony/dom-crawler": "7.4.*",
    "symfony/options-resolver": "7.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.89",
    "infection/infection": "^0.31",
    "deptrac/deptrac": "^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "DoctrineMigrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true,
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "test": [
      "@test:prepare",
      "phpunit"
    ],
    "test:coverage": [
      "@test:prepare",
      "php -d memory_limit=1G -d pcov.enabled=0 -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-clover var/coverage.xml --coverage-text",
      "php /app/scripts/check-coverage.php var/coverage.xml"
    ],
    "typecheck": "phpstan analyse --memory-limit=512M",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "architecture": "deptrac analyse --no-progress",
    "quality": [
      "@lint",
      "@typecheck",
      "@architecture",
      "@test",
      "php bin/console lint:container",
      "php bin/console lint:yaml config"
    ],
    "test:prepare": [
      "php bin/console doctrine:database:create --if-not-exists --env=test",
      "php bin/console doctrine:migrations:migrate --no-interaction --env=test"
    ]
  },
  "description": "Furniture OS prototype-v0 migration API",
  "license": "proprietary"
}
