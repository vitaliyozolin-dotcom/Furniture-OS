<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true" cacheDirectory="var/phpunit">
 <php><env name="AI_ENABLED" value="0" force="true"/><env name="POLZA_API_KEY" value="" force="true"/><env name="STORAGE_ROOT" value="var/test-files" force="true"/><env name="APP_ENV" value="test" force="true"/><env name="APP_DEBUG" value="1" force="true"/><server name="APP_ENV" value="test" force="true"/><server name="APP_DEBUG" value="1"/><server name="KERNEL_CLASS" value="App\Kernel"/></php>
 <testsuites><testsuite name="rendering"><directory>tests/Rendering</directory></testsuite><testsuite name="unit"><directory>tests/Unit</directory></testsuite><testsuite name="application"><directory>tests/Application</directory></testsuite><testsuite name="integration"><directory>tests/Integration</directory></testsuite><testsuite name="api"><directory>tests/Api</directory></testsuite></testsuites>
 <source><include><directory suffix=".php">src</directory></include><exclude><file>src/Kernel.php</file></exclude></source>
</phpunit>
