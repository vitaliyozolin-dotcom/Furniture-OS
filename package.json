{
  "name": "furniture-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @furniture-os/web",
    "build": "npm run build --workspace @furniture-os/web",
    "test": "npm run test --workspace @furniture-os/web",
    "test:fixtures:update": "npm run test:fixtures:update --workspace @furniture-os/web",
    "test:e2e": "npm run test:e2e --workspace @furniture-os/web",
    "test:e2e:update": "npm run test:e2e:update --workspace @furniture-os/web",
    "preview": "npm run preview --workspace @furniture-os/web",
    "typecheck": "npm run typecheck --workspace @furniture-os/web",
    "test:coverage": "npm run test:coverage --workspace @furniture-os/web",
    "lint": "npm run lint --workspace @furniture-os/web",
    "api:generate": "openapi-typescript contracts/openapi.yaml -o apps/web/src/shared/api/generated/schema.ts",
    "api:lint": "redocly lint --config .redocly.yaml contracts/openapi.yaml",
    "api:check": "node scripts/check-generated.mjs",
    "architecture": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run architecture && npm run api:lint && npm run build && node scripts/check-production-bundle.mjs"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "@redocly/cli": "2.63.0"
  }
}
